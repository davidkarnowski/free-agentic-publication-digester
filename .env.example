# Copy to .env and fill in. .env is git-ignored — never commit real values.

# Free key from https://api.data.gov/signup/
GOVINFO_API_KEY=

# Your contact email, included in the User-Agent so GPO can reach you if
# needed. Lives only in .env — do not put a real address in committed files.
CONTACT_EMAIL=

# Project mailbox for email-distributed sources (GUIDE §3; docs/email-sources.md).
# Gmail: enable 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it (spaces removed).
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Absolute base URL for published machine surfaces (sitemap, feed, robots,
# llms.txt, digests.json). The project's public domain is not a secret;
# leave empty to emit root-relative URLs for purely local viewing.
SITE_BASE_URL=https://fapd.info

# LLM backend (GUIDE §6 rule 7): "cli" (default) uses the `claude` CLI
# billed to the operator's Claude subscription; "api" uses the Anthropic
# API and needs ANTHROPIC_API_KEY with Console credits. On a headless
# host the CLI authenticates via a long-lived subscription token:
# run `claude setup-token` on the operator machine and set it here.
# Never set BOTH the OAuth token and an API key — the key shadows the
# token and silently switches billing.
LLM_BACKEND=cli
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Optional per-tier model overrides, e.g. to try a different strong model:
# FAPD_MAP_MODEL_API=claude-haiku-4-5-20251001
# FAPD_COMPOSE_MODEL_API=claude-sonnet-5
# On-demand daily token throttle (GUIDE §6 r8, operator ruling
# 2026-08-02): unset = unlimited (the default — there is deliberately no
# standing cap). Set an input-token count to engage backpressure: LLM
# calls pause for the rest of the UTC day once the ledger reaches it,
# queued to the next day and disclosed, never silently dropped.
# FAPD_DAILY_TOKEN_THROTTLE=2000000
