# /opt/fapd/logs/mcp-access.log — fapd-web's /mcp access log (bind mount).
# copytruncate because nginx in the container is not signalled by the
# host's logrotate; fail2ban's polling backend follows truncation.
/opt/fapd/logs/mcp-access.log {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
