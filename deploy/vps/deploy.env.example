# Box coordinates for deploy.sh and vps-ssh.sh.
#
# Copy to deploy/vps/deploy.env (gitignored) and fill in, then:
#     chmod 0600 deploy/vps/deploy.env
#
# The repository is PUBLIC (CLAUDE.md §13): this file's real counterpart
# is never committed, is excluded from BOTH rsync lists so it cannot bake
# into a container image, and is pinned by tests/test_deploy_secrets.py.
#
# Resolution order (deploy/vps/scripts/_env.sh):
#   1. $FAPD_DEPLOY_ENV        explicit override
#   2. deploy/vps/deploy.env   in-project — preferred
#   3. ~/.fapd-deploy.env      the original location, still honoured
SSH_KEY="$HOME/path/to/ssh_key"
VPS="user@host"
PORT="22"
REMOTE_DIR="/opt/fapd"
