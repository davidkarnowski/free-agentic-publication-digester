# Local settings for deploy.sh and dev-seed.sh.
#
# Copy to deploy/vps/deploy.env (gitignored), fill in, then:
#     chmod 0600 deploy/vps/deploy.env
#
# NO CONNECTION VALUES (2026-11-10): this project never holds a key path,
# a login, an address or a port. FAPD_BOX_CONNECT names an external
# connector command that supplies them (contract in
# deploy/vps/scripts/_env.sh; the private deploy README names it).
# _env.sh refuses a deploy.env that carries SSH_KEY, VPS or PORT, and
# tests/test_deploy_secrets.py pins it.
FAPD_BOX_CONNECT="/path/to/connector --its-options"
# The project's folder on the box (the default shown):
REMOTE_DIR="/opt/fapd"
