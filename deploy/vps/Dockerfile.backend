# FAPD backend: collector supervisor + end-of-day finalizer.
# Egress-only by network design (compose: fapd_backend private bridge, no
# published ports, NOT on fapd_edge). See docs/continuous-ingestion.md §9.
#
# CVE sweep 2026-10-30: pinned to an exact Python patch release on an exact
# Debian release. The floating `python:3.12-slim` tag plus Docker's layer
# cache had left the running image on Python 3.12.14 (bundled expat 2.8.3),
# OpenSSL 3.5.7-1~deb13u2 and libbrotli1 1.1.0-2+b7 for weeks after the
# fixes shipped. `apt-get upgrade` takes the Debian security updates the
# base image predates, and the libbrotli1 check fails the build unless
# curl's Brotli library carries the CVE-2026-111497 fix (DSA-6582-1; CISA
# KEV 2026-10-27). deploy.sh builds with --pull. Re-pin at each sweep.
FROM python:3.12.16-slim-trixie

RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends git openssh-client curl \
    && rm -rf /var/lib/apt/lists/* \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libbrotli1)" ge 1.1.0-2+deb13u1 \
    && pip install --no-cache-dir uv

# The claude CLI (LLM_BACKEND=cli, the operator's decision 2026-07-30;
# production again since 2026-08-24 after the vendor's 08-14..24 block —
# GUIDE §6 r7 provider record): pipeline LLM calls bill the operator's
# Claude subscription via a setup-token (CLAUDE_CODE_OAUTH_TOKEN in the
# server-side .env) instead of API credits. Node 22 is the CLI's runtime
# requirement. The image also serves the api/gemini/none backends, which
# need nothing installed here; dropping Node when the CLI is retired is
# plan OPS-3 (docs/ops/plan-2026-08-24-eod-llm-resilience.md).
# CVE sweep 2026-10-25: the Node 22 line must be 22.23.4 or later (the
# October 2026 Brotli and related fixes), checked at build time so an old
# NodeSource package cannot slip through; the claude CLI is pinned to an
# exact version (>= 2.1.179, the fix for GHSA-pq7j-f95f-qfcv) instead of
# whatever npm resolves on the day of the build. Re-pin at each sweep.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node -e 'const [a,b,c]=process.versions.node.split(".").map(Number); if (a!==22 || b<23 || (b===23 && c<4)) { console.error("node " + process.version + " is below 22.23.4"); process.exit(1) }' \
    && npm install -g @anthropic-ai/claude-code@2.1.310 \
    && claude --version

WORKDIR /app
# deploy.sh rsyncs the tested working tree (incl. .git — evidence
# commits push from here) to ./repo in the bundle; data/ and site/ are
# volumes, .env arrives via env_file at run time, never at build time.
COPY repo/ /app
RUN mkdir -p /app/static_assets && cp -r /app/site/assets/* /app/static_assets/ 2>/dev/null || true
RUN uv sync --frozen --no-dev

# Evidence commits are authored by the pipeline's bot identity and push
# over the mounted deploy key, which requires an SSH remote.
#
# The origin re-flip is BAKED HERE, not left to deploy.sh (F-020). The
# laptop tree carries an HTTPS remote (F-008), and deploy.sh's post-up
# `docker exec ... git remote set-url` writes to the RUNNING CONTAINER's
# writable layer — not the image. Any recreate outside a deploy therefore
# reverted it and silently broke evidence pushes: demonstrated 2026-08-05,
# when an OAuth-token rotation recreated the backend at 00:51 and the next
# `git push --dry-run` failed with `could not read Username for
# 'https://github.com'`. Nothing looked wrong until the push was actually
# tested, because fetch still worked — the repository is public, so
# anonymous HTTPS fetch succeeds.
#
# safe.directory is set in the same layer and BEFORE the remote command:
# a later `git config` would not help a `git -C /app` that runs first.
# The `||` fallback covers a build context whose .git somehow has no
# origin at all — `set-url` errors on a missing remote, and a build that
# dies there is harder to diagnose than one that just adds it.
#
# deploy.sh keeps its re-flip as belt-and-braces. The URL is duplicated
# across the two files and pinned by tests/test_evidence_commit.py so
# they cannot drift.
RUN git config --global user.name "fapd-pipeline" \
    && git config --global user.email "fapd-pipeline@users.noreply.github.com" \
    && git config --global --add safe.directory /app \
    && (git -C /app remote set-url origin \
          git@github.com:davidkarnowski/free-agentic-publication-digester.git \
        || git -C /app remote add origin \
          git@github.com:davidkarnowski/free-agentic-publication-digester.git) \
    && git -C /app remote -v

ENTRYPOINT ["uv", "run", "python", "scripts/collect.py"]
