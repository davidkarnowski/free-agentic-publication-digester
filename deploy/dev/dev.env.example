# Dev-stack environment — copy to deploy/dev/.env (gitignored) and edit.
# This file deliberately DIFFERS from the repo-root .env.example: the
# defaults here make dev artifacts impossible to mistake for production.

# Empty on purpose: root-relative links, correct for http://localhost:8080.
# The root .env.example ships https://fapd.info pre-filled — a copied prod
# env would make dev artifacts claim to be production. Never fill this in.
SITE_BASE_URL=

# Dev-labeled contact string: this feeds the User-Agent sent to real .gov
# hosts in live mode. Identify the traffic as a dev run.
CONTACT_EMAIL=dev-stack-test@localhost

# Live mode (--profile live) only. USE A SEPARATE DEV KEY from
# https://api.data.gov/signup/ — request budgets are counted from each
# machine's own fetch log, so dev and production sharing one key would
# each believe they are under the publisher's per-key limit while jointly
# exceeding it. Render mode needs no key: leave empty.
GOVINFO_API_KEY=

# Never set in dev. dev-up.sh refuses to start if this is "1" anywhere —
# the dev stack must be physically unable to push to the production repo.
# FAPD_EVIDENCE_PUSH=

# The mailbox is production's; dev does not poll it. Leave unset.
# IMAP_HOST=
# IMAP_USER=
# IMAP_PASSWORD=
