# Secrets — never commit
.env
# Box coordinates for deploy.sh / vps-ssh.sh — local only, never committed
# (CLAUDE.md §13). The bare `.env` rule above does not match this filename.
deploy/vps/deploy.env

# Fetched government documents & local database (regenerable; can get large)
data/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store

# Local research/analysis material (NotebookLM bundles etc.) — never published
research/
# Assistant-harness: local settings stay out; skills and section-agent
# launchers are tracked project assets. The pattern must be `.claude/*`
# (not `.claude/`) for the re-includes to work.
.claude/*
!.claude/skills/
!.claude/agents/

# /today live view — derived-only, never committed (GUIDE §5 two-artifact
# model); the canonical record is the dated digest the EOD gates freeze.
site/today.html
site/today.json

# Dev-stack staged build context (deploy/dev/scripts/dev-up.sh) — a full
# working-tree copy; covers the gitignored-but-present site/today.* and
# the .claude re-include leak transitively.
deploy/dev/repo/

# Operator-only planning notes: candid risk/cost/sequencing documents that
# are not part of the public record (CLAUDE.md §13). The public counterpart
# is docs/roadmap.md.
docs/private/
