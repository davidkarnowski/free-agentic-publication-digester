# Secrets — never commit
.env

# Fetched government documents & local database (regenerable; can get large)
data/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store

# Local research/analysis material (NotebookLM bundles etc.) — never published
research/
# Assistant-harness: local settings stay out; skills are tracked project
# assets. The pattern must be `.claude/*` (not `.claude/`) for the
# re-include to work.
.claude/*
!.claude/skills/
